<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="coffee.api.mapper.UpdateInvoiceMapper">

  <!-- 1. Lock invoice so edits, payment and cancellation cannot overwrite each other -->
  <select id="findInvoiceById" resultType="coffee.api.dto.result.InvoiceResult">
    <include refid="coffee.api.mapper.CommonMapper.lockInvoiceSql"/>
  </select>

  <!-- 2. Validate and lock the current occupied table -->
  <select id="lockOccupiedTable" resultType="java.util.UUID">
    <include refid="coffee.api.mapper.CommonMapper.lockOccupiedInvoiceTableSql"/>
  </select>

  <!-- 3. Only an active unpaid invoice in the validated shop can be edited -->
  <update id="updateInvoice">
    UPDATE invoices
    SET table_id = #{tableId}, total_amount = #{totalAmount}, update_at = NOW() AT TIME ZONE 'Asia/Ho_Chi_Minh'
    WHERE invoice_id = #{invoiceId}
    AND shop_id = #{shopId}
    AND deleted_at IS NULL
    AND is_deleted = FALSE
    AND status = 0
  </update>

  <!-- 4. Release the old table after the invoice has moved -->
  <update id="releaseTable">
    <include refid="coffee.api.mapper.CommonMapper.releaseInvoiceTableSql"/>
  </update>

  <!-- 5. Replace the details within the same transaction -->
  <delete id="deleteInvoiceDetails">
    DELETE FROM invoice_details WHERE invoice_id = #{invoiceId}
  </delete>
</mapper>
