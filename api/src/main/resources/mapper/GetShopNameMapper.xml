<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="coffee.api.mapper.GetShopNameMapper">

  <select id="getShopNames" resultType="coffee.api.dto.result.ShopNameResult">
    SELECT
      shop_id AS shopId,
      shop_name AS shopName
    FROM shops
  </select>

</mapper>