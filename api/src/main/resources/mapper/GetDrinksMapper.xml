<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="coffee.api.mapper.GetDrinksMapper">

  <resultMap id="DrinkResultMap" type="coffee.api.dto.result.DrinkResult">
    <id property="drinkId" column="drink_id" javaType="java.util.UUID"/>
    <result property="drinkCategoryId" column="drink_category_id" javaType="java.util.UUID"/>
    <result property="drinkName" column="drink_name"/>
    <result property="imageUrl" column="image_url"/>
    <result property="status" column="status"/>
    <result property="isDeleted" column="is_deleted"/>

    <!-- Map variants khi có JOIN với drink_details -->
    <collection property="variants" javaType="java.util.List" ofType="coffee.api.dto.result.DrinkResult$DrinkVariantResult">
      <result property="size" column="size"/>
      <result property="price" column="price"/>
    </collection>
  </resultMap>

  <sql id="filterConditions">
    <where>
      d.is_deleted = false AND dc.is_deleted = false

      <if test="currentUserRoleName != 'OWNER'">
        AND d.shop_id = #{currentUserShopId}
      </if>

      <if test="search != null and search != ''">
        AND (d.drink_name ILIKE '%' || #{search} || '%' OR dc.category_name ILIKE '%' || #{search} || '%')
      </if>
    </where>
  </sql>

  <select id="getDrinksFiltered" resultMap="DrinkResultMap">
    SELECT
    d.drink_id,
    d.drink_category_id,
    d.drink_name,
    d.image_url,
    d.status,
    d.is_deleted

    <!-- Chọn thêm size, price khi truyền drinkId -->
    <if test="drinkId != null">
      , dd.size, dd.price
    </if>

    FROM drinks AS d
    JOIN drink_categories AS dc ON d.drink_category_id = dc.drink_category_id

    <!-- Chỉ LEFT JOIN drink_details khi xem chi tiết (drinkId != null) -->
    <if test="drinkId != null">
      LEFT JOIN drink_details AS dd ON d.drink_id = dd.drink_id
    </if>

    <include refid="filterConditions"/>

    <!-- Lọc theo drinkId cụ thể khi xem chi tiết -->
    <if test="drinkId != null">
      AND d.drink_id = #{drinkId}
    </if>

    <!-- Phân trang khi lấy danh sách -->
    <if test="drinkId == null">
      ORDER BY d.drink_id
      <if test="sortDirection != null and sortDirection != ''">
        ${sortDirection}
      </if>
      LIMIT #{size} OFFSET #{offset}
    </if>
  </select>

  <select id="countDrinksFiltered" resultType="long">
    SELECT count(DISTINCT d.drink_id)
    FROM drinks AS d
    JOIN drink_categories AS dc ON d.drink_category_id = dc.drink_category_id
    <include refid="filterConditions"/>
    <if test="drinkId != null">
      AND d.drink_id = #{drinkId}
    </if>
  </select>

</mapper>