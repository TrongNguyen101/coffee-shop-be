# Production Environment Configuration
# Copy this file to .env.prod and update values as needed
# Then run: docker run --env-file .env.prod -p 8080:8080 coffee-api:latest

# Spring Profile (MUST be prod for production)
SPRING_PROFILES_ACTIVE=prod

# Supabase Database Configuration
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
