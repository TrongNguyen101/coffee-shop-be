<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="coffee.api.mapper.PrintInvoiceMapper">

  <!-- 1. Map the invoice header and its drink lines for the receipt -->
  <resultMap id="InvoiceReceiptResultMap" type="coffee.api.dto.result.InvoiceReceiptResult">
    <id property="invoiceId" column="invoice_id" javaType="java.util.UUID"/>
    <result property="invoiceCode" column="invoice_code"/>
    <result property="shopId" column="shop_id" javaType="java.util.UUID"/>
    <result property="shopName" column="shop_name"/>
    <result property="shopAddress" column="shop_address"/>
    <result property="shopPhone" column="shop_phone"/>
    <result property="staffName" column="staff_name"/>
    <result property="tableNumber" column="table_number"/>
    <result property="totalAmount" column="total_amount"/>
    <result property="status" column="status"/>
    <result property="createdAt" column="created_at"/>
    <collection property="items" resultMap="coffee.api.mapper.GetInvoiceMapper.InvoiceItemResultMap"/>
  </resultMap>

  <!-- 2. Load one active invoice with shop, staff, table and active detail rows -->
  <select id="findInvoiceForPrint" resultMap="InvoiceReceiptResultMap">
    SELECT
    i.invoice_id,
    i.invoice_code,
    i.shop_id,
    s.shop_name,
    s.address AS shop_address,
    s.phone_number AS shop_phone,
    p.full_name AS staff_name,
    st.table_number,
    i.total_amount,
    i.status,
    i.created_at,
    <include refid="coffee.api.mapper.GetInvoiceMapper.invoiceItemColumns"/>
    FROM invoices i
    JOIN shops s ON i.shop_id = s.shop_id
    LEFT JOIN profiles p ON i.profile_id = p.profile_id
    LEFT JOIN shop_tables st ON st.table_id = i.table_id
    LEFT JOIN invoice_details id ON id.invoice_id = i.invoice_id
      AND id.deleted_at IS NULL
    <include refid="coffee.api.mapper.GetInvoiceMapper.invoiceItemDrinkJoins"/>
    WHERE i.invoice_id = #{invoiceId}
    AND i.deleted_at IS NULL
    AND i.is_deleted = FALSE
    ORDER BY id.invoice_detail_id ASC
  </select>

</mapper>
