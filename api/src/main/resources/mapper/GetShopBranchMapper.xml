<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="coffee.api.mapper.GetShopBranchMapper">

  <!-- 1. Result Map matching ShopBranchResult DTO -->
  <resultMap id="ShopBranchResultMap" type="coffee.api.dto.result.ShopBranchResult">
    <id property="shopId" column="shop_id" javaType="java.util.UUID"/>
    <result property="shopName" column="shop_name"/>
    <result property="address" column="address"/>
    <result property="phoneNumber" column="phone_number"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
    <result property="isDeleted" column="is_deleted"/>
  </resultMap>

  <!-- 2. Reusable SQL Fragment for filtering -->
  <sql id="shopBranchFilterCondition">
    <!-- Exclude soft-deleted branches -->
    s.is_deleted = false

    <!-- Only OWNER can view all shops -->
    <if test="currentUserRoleName != 'OWNER'">
      AND s.shop_id IN (
      SELECT ps.shop_id
      FROM profile_shops ps
      WHERE ps.profile_id = #{currentUserId}
      )
    </if>

    <!-- Text Search Constraints -->
    <if test="search != null and search != ''">
      AND (
      s.shop_name ILIKE CONCAT('%', #{search}, '%')
      OR s.address ILIKE CONCAT('%', #{search}, '%')
      OR s.phone_number ILIKE CONCAT('%', #{search}, '%')
      OR s.shop_id::text ILIKE CONCAT('%', #{search}, '%')
      )
    </if>
  </sql>

  <!-- 3. Fetch filtered and paginated shop branches -->
  <select id="getShopBranchesFiltered" resultMap="ShopBranchResultMap">
    SELECT
    s.shop_id,
    s.shop_name,
    s.address,
    s.phone_number,
    s.created_at,
    s.updated_at,
    s.is_deleted
    FROM shops s
    <where>
      <include refid="shopBranchFilterCondition"/>
    </where>

    ORDER BY
    <choose>
      <when test="sortBy == 'shopId'">s.shop_id</when>
      <when test="sortBy == 'shopName'">s.shop_name</when>
      <when test="sortBy == 'address'">s.address</when>
      <when test="sortBy == 'phoneNumber'">s.phone_number</when>
      <when test="sortBy == 'createdAt'">s.created_at</when>
      <when test="sortBy == 'updatedAt'">s.updated_at</when>
      <when test="sortBy == 'isDeleted'">s.is_deleted</when>
      <otherwise>s.created_at</otherwise>
    </choose>
    <choose>
      <when test="sortDirection != null and sortDirection.toUpperCase() == 'DESC'">DESC</when>
      <otherwise>ASC</otherwise>
    </choose>

    LIMIT #{size} OFFSET #{offset}
  </select>

  <!-- 4. Count total matches for pagination -->
  <select id="countShopBranchesFiltered" resultType="long">
    SELECT COUNT(*)
    FROM shops s
    <where>
      <include refid="shopBranchFilterCondition"/>
    </where>
  </select>

</mapper>