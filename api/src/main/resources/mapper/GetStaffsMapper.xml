<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="coffee.api.mapper.GetStaffsMapper">

  <!-- Reusable Result Map for mapping database columns to ProfileResult -->
  <resultMap id="ProfileResultMap" type="coffee.api.dto.result.ProfileResult">
    <id property="profileId" column="profile_id"/>
    <result property="email" column="email"/>
    <result property="username" column="username"/>
    <result property="fullName" column="full_name"/>
    <result property="phoneNumber" column="phone_number"/>
    <result property="shopName" column="shop_name"/>
    <result property="roleName" column="role_name"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
    <result property="isDeleted" column="is_deleted"/>
  </resultMap>

  <!-- Reusable SQL Fragment for filtering by role scope, shops, and search term -->
  <sql id="staffsFilterCondition">
    <!-- CRITICAL: Exclude deleted users, roles, and shops from the results -->
    u.is_deleted = false
    AND r.is_deleted = false
    AND s.is_deleted = false

    <!-- Append the role-based scoping rules -->
    AND
    <choose>
      <!-- OWNER: Can view all STAFF and MANAGER roles across all stores -->
      <when test="currentUserRoleName == 'OWNER'">
        r.role_name IN ('STAFF', 'MANAGER')
      </when>

      <!-- MANAGER: Can view ONLY 'STAFF' who share the same shop assignments -->
      <when test="currentUserRoleName == 'MANAGER'">
        r.role_name = 'STAFF'
        AND u.profile_id IN (
        SELECT target_ps.profile_id
        FROM profile_shops target_ps
        WHERE target_ps.shop_id IN (
        SELECT mgr_ps.shop_id
        FROM profile_shops mgr_ps
        WHERE mgr_ps.profile_id = #{currentUserId}
        )
        )
      </when>

      <!-- FALLBACK / OTHER: Default safety isolation layer -->
      <otherwise>
        r.role_name = 'STAFF'
      </otherwise>
    </choose>

    <!-- Text Search Constraints -->
    <if test="search != null and search != ''">
      AND (
      u.username LIKE CONCAT('%', #{search}, '%')
      OR u.email LIKE CONCAT('%', #{search}, '%')
      OR u.full_name LIKE CONCAT('%', #{search}, '%')
      OR u.phone_number LIKE CONCAT('%', #{search}, '%')
      OR s.shop_name LIKE CONCAT('%', #{search}, '%')
      )
    </if>
  </sql>

  <!-- 1. Fetch filtered and paginated staff/manager members -->
  <select id="getStaffsFiltered" resultMap="ProfileResultMap">
    SELECT
    u.profile_id,
    u.email,
    u.username,
    u.full_name,
    u.phone_number,
    s.shop_name,
    r.role_name,
    u.created_at,
    u.updated_at,
    u.is_deleted
    FROM profiles u
    INNER JOIN roles r ON u.role_id = r.role_id
    INNER JOIN profile_shops ps ON u.profile_id = ps.profile_id
    INNER JOIN shops s ON ps.shop_id = s.shop_id
    <where>
      <include refid="staffsFilterCondition"/>
    </where>

    ORDER BY
    <choose>
      <when test="sortBy == 'profileId'">u.profile_id</when>
      <when test="sortBy == 'email'">u.email</when>
      <when test="sortBy == 'username'">u.username</when>
      <when test="sortBy == 'fullName'">u.full_name</when>
      <when test="sortBy == 'phoneNumber'">u.phone_number</when>
      <when test="sortBy == 'shopName'">s.shop_name</when>
      <when test="sortBy == 'roleName'">r.role_name</when>
      <when test="sortBy == 'createdAt'">u.created_at</when>
      <when test="sortBy == 'updatedAt'">u.updated_at</when>
      <otherwise>u.profile_id</otherwise>
    </choose>
    <choose>
      <when test="sortDirection != null and sortDirection.toUpperCase() == 'DESC'">DESC</when>
      <otherwise>ASC</otherwise>
    </choose>

    LIMIT #{size} OFFSET #{offset}
  </select>

  <!-- 2. Count total matches for metadata pagination -->
  <select id="countStaffsFiltered" resultType="long">
    SELECT COUNT(*)
    FROM profiles u
    INNER JOIN roles r ON u.role_id = r.role_id
    INNER JOIN profile_shops ps ON u.profile_id = ps.profile_id
    INNER JOIN shops s ON ps.shop_id = s.shop_id
    <where>
      <include refid="staffsFilterCondition"/>
    </where>
  </select>

</mapper>