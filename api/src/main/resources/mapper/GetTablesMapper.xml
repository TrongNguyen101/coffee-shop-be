<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="coffee.api.mapper.GetTablesMapper">

  <resultMap id="TableResultMap" type="coffee.api.dto.result.TableResult">
    <id property="tableId" column="table_id"/>
    <result property="shopId" column="shop_id"/>
    <result property="shopName" column="shop_name"/>
    <result property="tableNumber" column="table_number"/>
    <result property="description" column="description"/>
    <result property="status" column="status"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>

  <sql id="tablesFilterCondition">
    st.is_deleted = false
    AND st.deleted_at IS NULL
    AND s.deleted_at IS NULL

    <choose>
      <!-- OWNER: Can view all tables or filter by shopId -->
      <when test="currentUserRoleName == 'OWNER'">
        <if test="shopId != null">
          AND st.shop_id = #{shopId}
        </if>
      </when>

      <!-- MANAGER and STAFF: Strictly restricted to their assigned shop -->
      <when test="currentUserRoleName == 'MANAGER' or currentUserRoleName == 'STAFF'">
        AND st.shop_id = #{currentUserShopId}
      </when>

      <otherwise>
        AND 1 = 0
      </otherwise>
    </choose>

    <!-- Filter by status -->
    <if test="status != null">
      AND st.status = #{status}
    </if>

    <!-- Search by table number or description -->
    <if test="search != null and search != ''">
      AND (
        CAST(st.table_number AS VARCHAR) ILIKE CONCAT('%', #{search}, '%')
        OR st.description ILIKE CONCAT('%', #{search}, '%')
      )
    </if>
  </sql>

  <select id="getTablesFiltered" resultMap="TableResultMap">
    SELECT
      st.table_id,
      st.shop_id,
      s.shop_name,
      st.table_number,
      st.description,
      st.status,
      TO_CHAR(st.created_at, 'YYYY-MM-DD"T"HH24:MI:SS') AS created_at,
      TO_CHAR(st.updated_at, 'YYYY-MM-DD"T"HH24:MI:SS') AS updated_at
    FROM shop_tables st
    JOIN shops s ON s.shop_id = st.shop_id
    <where>
      <include refid="tablesFilterCondition"/>
    </where>

    ORDER BY
    <choose>
      <when test="sortBy == 'tableId'">st.table_id</when>
      <when test="sortBy == 'tableNumber'">st.table_number</when>
      <when test="sortBy == 'status'">st.status</when>
      <when test="sortBy == 'createdAt'">st.created_at</when>
      <when test="sortBy == 'updatedAt'">st.updated_at</when>
      <otherwise>st.table_number</otherwise>
    </choose>
    <choose>
      <when test="sortDirection != null and sortDirection.toUpperCase() == 'DESC'">DESC</when>
      <otherwise>ASC</otherwise>
    </choose>

    LIMIT #{size} OFFSET #{offset}
  </select>

  <select id="countTablesFiltered" resultType="long">
    SELECT COUNT(*)
    FROM shop_tables st
    JOIN shops s ON s.shop_id = st.shop_id
    <where>
      <include refid="tablesFilterCondition"/>
    </where>
  </select>

</mapper>