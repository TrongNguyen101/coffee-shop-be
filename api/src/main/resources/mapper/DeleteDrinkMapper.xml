<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="coffee.api.mapper.DeleteDrinkMapper">

  <update id="deleteDrink">
    UPDATE drinks
    SET is_deleted = TRUE
    WHERE drink_id = #{drinkId}
    AND is_deleted = FALSE
    <choose>
      <!-- OWNER can soft-delete drinks across all shops -->
      <when test="currentUserRoleName == 'OWNER'">
        <!-- No shop restriction -->
      </when>

      <!-- MANAGER can only soft delete drinks belonging to their shop -->
      <when test="currentUserRoleName == 'MANAGER'">
        AND shop_id = #{currentUserShopId}
      </when>
    </choose>
  </update>

</mapper>